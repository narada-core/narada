{
  "name": "narada",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "type": "module",
  "homepage": "https://narada.systems",
  "scripts": {
    "narada:install-shim": "bash scripts/install-narada-shim.sh",
    "pack:artifact": "node scripts/pack-artifact.mjs",
    "narada:guard-task-db": "node --import tsx scripts/guard-task-lifecycle-db.ts",
    "narada:guard-task-db:test": "node --import tsx --test scripts/guard-task-lifecycle-db.test.ts",
    "narada:guard-cli-output": "node --import tsx scripts/cli-output-admission-guard.ts",
    "narada:guard-cli-output:report": "node --import tsx scripts/cli-output-admission-guard.ts --report",
    "narada:guard-process-launch-posture": "node --import tsx scripts/process-launch-posture-guard.ts",
    "narada:guard-process-launch-posture:report": "node --import tsx scripts/process-launch-posture-guard.ts --report",
    "narada:guard-process-launch-posture:test": "node --import tsx --test scripts/process-launch-posture-guard.test.ts",
    "operator-surface-carrier-matrix:test": "node --import tsx --test tools/operator-surface-carriers/carrier-conformance-matrix.test.ts",
    "narada:verify-workspace-launch-hidden-runtime": "pwsh -NoProfile -File packages/layers/cli/scripts/verify-workspace-launch-hidden-runtime.ps1",
    "narada:guard-site-paths": "node --import tsx scripts/site-path-semantics-guard.ts",
    "narada:guard-intelligence-zero-consumer": "node --import tsx scripts/intelligence-legacy-consumer-inventory.ts",
    "narada:guard-intelligence-zero-consumer:test": "node --import tsx --test scripts/intelligence-legacy-consumer-inventory.test.ts",
    "narada:guard-task-executability-docs:test": "node --import tsx --test scripts/task-executability-docs.test.ts",
    "site:continuity:loop": "node --import tsx scripts/site-continuity-loop.ts",
    "site:continuity:loop:test": "node --import tsx --test scripts/site-continuity-loop.test.ts",
    "cloudflare:operator:check": "node --import tsx scripts/cloudflare-operator-check.ts",
    "cloudflare:operator:check:human": "node --import tsx scripts/cloudflare-operator-check.ts --require-operator-session",
    "cloudflare:operator:check:human-action": "node --import tsx scripts/cloudflare-operator-check.ts --require-human-operator-action",
    "cloudflare:operator:check:test": "node --import tsx --test scripts/cloudflare-operator-check.test.ts",
    "cloudflare:product:readiness": "node --import tsx scripts/cloudflare-product-readiness.ts",
    "cloudflare:product:readiness:test": "node --import tsx --test scripts/cloudflare-product-readiness.test.ts",
    "cloudflare:operator:login": "node --import tsx scripts/cloudflare-operator-login.ts",
    "cloudflare:operator:site:bootstrap": "node --import tsx scripts/cloudflare-operator-site-bootstrap.ts",
    "cloudflare:operator:operation:bootstrap": "node --import tsx scripts/cloudflare-operator-operation-bootstrap.ts",
    "cloudflare:intelligence:deploy": "pnpm --filter @narada-core/cloudflare-carrier intelligence:deploy",
    "cloudflare:intelligence:deploy:dry-run": "pnpm --filter @narada-core/cloudflare-carrier intelligence:deploy:dry-run",
    "test": "tsx scripts/test-guard.ts",
    "verify": "node --import tsx scripts/verify.ts",
    "test:unit": "tsx scripts/test-unit.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:full": "tsx scripts/test-full.ts",
    "test:focused": "node --import tsx scripts/test-focused.ts",
    "agent-tui:test:focused": "pwsh -NoProfile -File tools/agent-tui/test-agent-tui.ps1",
    "agent-tui:test": "pwsh -NoProfile -File tools/agent-tui/test-agent-tui.ps1 -Full",
    "agent-tui:test:verbose": "pwsh -NoProfile -File tools/agent-tui/test-agent-tui.ps1 -Full -VerboseOutput",
    "agent-tui:test:wrapper": "node --import tsx --test --test-reporter=dot tools/agent-tui/test-agent-tui.test.ts",
    "agent-start:test": "node --import tsx --test --test-reporter=dot tools/agent-start/start-agent.test.ts",
    "agent-tui:live-turn-acceptance": "node --import tsx tools/agent-start/agent-tui-live-turn-acceptance.ts",
    "agent-tui:live-turn-acceptance:test": "node --import tsx --test --test-reporter=dot tools/agent-start/agent-tui-live-turn-acceptance.test.ts",
    "agent-start:test:verbose": "node --import tsx --test tools/agent-start/start-agent.test.ts",
    "test:agent-web-ui:live:delegated-task": "pnpm --filter @narada-core/agent-web-ui test:live:delegated-task",
    "test:agent-pi-tui:live": "pnpm --filter @narada-core/agent-pi-tui test:live:e2e && pnpm --filter @narada-core/agent-runtime-server test:live:pi-client-kernel",
    "test:agent-pi-tui:live:fixture": "pnpm --filter @narada-core/agent-pi-tui test:live:guard && pnpm --filter @narada-core/agent-pi-tui test:live:local && pnpm --filter @narada-core/agent-runtime-server test:live:pi-client-kernel",
    "test:agent-pi-tui:live:production-binding": "pnpm --filter @narada-core/agent-pi-tui test:live:production-binding && pnpm --filter @narada-core/agent-runtime-server test:live:pi-client-kernel",
    "test:control-plane": "pnpm --filter @narada-core/control-plane test",
    "test:daemon": "pnpm --filter @narada-core/daemon test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "benchmark": "pnpm -r benchmark",
    "benchmark:compare": "tsx scripts/benchmark-compare.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "tsx scripts/publish-local.ts",
    "control-plane-lint": "tsx scripts/control-plane-lint.ts",
    "prebuild": "node --import tsx scripts/sibling-workspace-state-guard.ts",
    "pretypecheck": "node --import tsx scripts/sibling-workspace-state-guard.ts",
    "prepublish-check": "tsx scripts/prepublish-check.ts",
    "pack:check": "tsx scripts/prepublish-check.ts --pack-only",
    "toolchain:oxbuild-probe": "node --import tsx scripts/oxbuild-probe.ts",
    "typescript:source-boundary": "node --import tsx --test scripts/typescript-source-boundary.test.ts",
    "typecheck:tools": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.tools.json"
  },
  "config": {
    "uscVersion": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@narada-core/agent-cli": "workspace:*",
    "@narada-core/agent-runtime-server": "workspace:*",
    "@narada-core/agent-tui": "workspace:*",
    "@narada-core/agent-web-ui": "workspace:*",
    "@narada-core/cli": "workspace:*",
    "@types/node": "^22.0.0",
    "oxbuild": "^0.1.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
