{
  "name": "@narada-core/agent-runtime-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "narada": {
    "package_role": "nars_runtime_server",
    "owns": [
      "server_request_handling",
      "server_request_lifecycle",
      "session_binding",
      "session_status_and_health_projection",
      "health_projection_request_lifecycle",
      "runtime_event_subscription",
      "runtime_lifecycle_hooks",
      "runtime_intelligence_reconfiguration",
      "artifact_http_request_handling",
      "attachment_contract",
      "carrier_substrate_handoff",
      "runtime_host_lifecycle",
      "capability_gateway_binding"
    ],
    "carrier_substrate": "@narada-core/carrier-runtime in-process",
    "runtime_dependency_owner": "nars-session-core owns session control and durability; this package owns the scoped capability-gateway binding; nars-provider-runtime supplies provider execution"
  },
  "bin": {
    "narada-agent-runtime-server": "./dist/bin/narada-agent-runtime-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/server-wrapper.d.ts",
      "import": "./dist/src/server-wrapper.js",
      "default": "./dist/src/server-wrapper.js"
    },
    "./runtime-session-binding": {
      "types": "./dist/src/runtime-session-binding.d.ts",
      "import": "./dist/src/runtime-session-binding.js",
      "default": "./dist/src/runtime-session-binding.js"
    },
    "./session-core-runtime-service": {
      "types": "./dist/src/session-core-runtime-service.d.ts",
      "import": "./dist/src/session-core-runtime-service.js",
      "default": "./dist/src/session-core-runtime-service.js"
    },
    "./runtime-context": {
      "types": "./dist/src/runtime-context.d.ts",
      "import": "./dist/src/runtime-context.js",
      "default": "./dist/src/runtime-context.js"
    },
    "./control-input-bridge": {
      "types": "./dist/src/control-input-bridge.d.ts",
      "import": "./dist/src/control-input-bridge.js",
      "default": "./dist/src/control-input-bridge.js"
    },
    "./runtime-host-state": {
      "types": "./dist/src/runtime-host-state.d.ts",
      "import": "./dist/src/runtime-host-state.js",
      "default": "./dist/src/runtime-host-state.js"
    },
    "./runtime-request-state": {
      "types": "./dist/src/runtime-request-state.d.ts",
      "import": "./dist/src/runtime-request-state.js",
      "default": "./dist/src/runtime-request-state.js"
    },
    "./health-projection-request-state": {
      "types": "./dist/src/health-projection-request-state.d.ts",
      "import": "./dist/src/health-projection-request-state.js",
      "default": "./dist/src/health-projection-request-state.js"
    },
    "./runtime-control-contract": {
      "types": "./dist/src/runtime-control-contract.d.ts",
      "import": "./dist/src/runtime-control-contract.js",
      "default": "./dist/src/runtime-control-contract.js"
    },
    "./intelligence-runtime-reconfiguration-state": {
      "types": "./dist/src/intelligence-runtime-reconfiguration-state.d.ts",
      "import": "./dist/src/intelligence-runtime-reconfiguration-state.js",
      "default": "./dist/src/intelligence-runtime-reconfiguration-state.js"
    },
    "./intelligence-runtime-controller": {
      "types": "./dist/src/intelligence-runtime-controller.d.ts",
      "import": "./dist/src/intelligence-runtime-controller.js",
      "default": "./dist/src/intelligence-runtime-controller.js"
    },
    "./local-intelligence-runtime": {
      "types": "./dist/src/local-intelligence-runtime.d.ts",
      "import": "./dist/src/local-intelligence-runtime.js",
      "default": "./dist/src/local-intelligence-runtime.js"
    },
    "./local-topology-observer": {
      "types": "./dist/src/local-topology-observer.d.ts",
      "import": "./dist/src/local-topology-observer.js",
      "default": "./dist/src/local-topology-observer.js"
    },
    "./runtime-server-events": {
      "types": "./dist/src/runtime-server-events.d.ts",
      "import": "./dist/src/runtime-server-events.js",
      "default": "./dist/src/runtime-server-events.js"
    },
    "./task-executability-dispatch": {
      "types": "./dist/src/task-executability-dispatch.d.ts",
      "import": "./dist/src/task-executability-dispatch.js",
      "default": "./dist/src/task-executability-dispatch.js"
    },
    "./test-fixtures": {
      "types": "./dist/src/test-fixtures.d.ts",
      "import": "./dist/src/test-fixtures.js",
      "default": "./dist/src/test-fixtures.js"
    },
    "./agent-cli-windows-wrapper-template": "./templates/Start-AgentCliSession.ps1",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:typescript && pnpm run build:native",
    "build:typescript": "tsc -p tsconfig.build.json",
    "build:native": "cargo build --manifest-path native/Cargo.toml --release",
    "build:runtime": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=360000 test/*.test.ts src/*.test.ts",
    "pretest:one-by-one": "pnpm run build",
    "test:one-by-one": "node --import tsx test/run-one-by-one.ts",
    "test:e2e:pty": "node --import tsx test/pty-e2e.ts",
    "test:live:pi-client-kernel": "node --import tsx test/live-pi-client-kernel-substitutability-fixture-e2e.ts --enable-live-e2e",
    "test:live:codex-provider-admission": "pnpm --filter @narada-core/cli build && node --import tsx test/live-codex-provider-admission-e2e.ts --enable-live-codex",
    "benchmark:runtime-engine": "node --import tsx test/runtime-engine-boundary-benchmark.ts",
    "benchmark:session-core": "node --import tsx test/runtime-engine-session-core-benchmark.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@narada-core/agent-identity": "workspace:*",
    "@narada-core/carrier-command-contract": "workspace:*",
    "@narada-core/carrier-runtime": "workspace:*",
    "@narada-core/carrier-protocol": "workspace:*",
    "@narada-core/carrier-terminal-projection": "workspace:*",
    "@narada-core/carrier-provider-support": "workspace:*",
    "@narada-core/invokable-intelligence-materialization": "workspace:*",
    "@narada-core/invokable-intelligence-contract": "workspace:*",
    "@narada-core/invokable-intelligence-registry": "workspace:*",
    "@narada-core/invokable-intelligence-resolver": "workspace:*",
    "@narada-core/invokable-intelligence-runtime": "workspace:*",
    "@narada-core/launch-process-ownership": "workspace:*",
    "@narada-core/nars-session-authority": "workspace:*",
    "@narada-core/nars-session-core": "workspace:*",
    "@narada-core/nars-runtime-contract": "workspace:*",
    "@narada-core/nars-capability-gateway": "workspace:*",
    "@narada-core/nars-intelligence-kernel-contract": "workspace:*",
    "@narada-core/nars-pi-kernel": "workspace:*",
    "@narada-core/nars-provider-runtime": "workspace:*",
    "@narada-core/operator-surface-runtime-contract": "workspace:*",
    "@narada-core/orientation-manifest": "workspace:*",
    "@narada-core/process-launch-posture": "workspace:*",
    "@narada-core/site-paths": "workspace:*"
  },
  "devDependencies": {
    "node-pty": "^1.1.0"
  },
  "description": "NARS runtime server for session and carrier handoff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/agent-runtime-server"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
