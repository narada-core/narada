{
  "name": "@narada-core/cli",
  "version": "0.1.0",
  "description": "CLI for the Narada deterministic state compiler and control plane",
  "homepage": "https://narada.systems",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "narada": {
    "launch_artifact": {
      "target": "narada-cli",
      "build_script": "build",
      "output_root": "dist",
      "required_outputs": [
        "main.js",
        "index.js",
        "mcp-main.js",
        "ui/workbench.html"
      ]
    }
  },
  "bin": {
    "narada": "./dist/main.js",
    "narada-mcp": "./dist/mcp-main.js"
  },
  "files": [
    "dist/",
    "dist/assets/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/layers/cli"
  },
  "keywords": [
    "narada",
    "state-compiler",
    "sync",
    "exchange",
    "microsoft-graph",
    "email",
    "automation",
    "cli"
  ],
  "author": "Narada <team@narada.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bundleDependencies": [
    "@narada-core/agent-context-memory",
    "@narada-core/agent-context-mcp",
    "@narada-core/agent-identity",
