  "scripts": {
    "prepublishOnly": "node --import tsx ../../../scripts/assert-publication-admission.ts && pnpm run test:linux-installation-e2e",
    "prepack": "pnpm --filter @narada-core/site-common-tools build && pnpm run build",
    "prebuild": "node scripts/run-quiet-command.mjs pnpm --filter @narada-core/cli... --filter \"!@narada-core/cli\" build && pnpm --filter @narada-core/cloudflare-operator-projection build && node scripts/run-quiet-command.mjs pnpm --filter @narada-core/agent-start check:result-contract",
    "build": "tsc && node --import tsx scripts/write-build-manifest.ts",
    "pretypecheck": "pnpm --filter @narada-core/cloudflare-operator-projection build",
    "typecheck": "tsc --noEmit",
    "test:artifact": "node --import tsx --test test/lib/launch-artifact.test.ts",
    "pretest": "pnpm run build && pnpm --filter @narada-core/cloudflare-operator-projection build && pnpm --filter @narada-core/operator-router build && pnpm --filter @narada-core/ui build && pnpm --filter @narada-core/operator-console-ui build",
    "test": "node --import tsx scripts/run-vitest-quiet.ts run --silent && pnpm run test:realfs",
    "test:launcher": "pnpm run build && node --import tsx scripts/run-vitest-quiet.ts run --silent test/commands/carrier-launcher.test.ts test/commands/launcher-workspace-plan.test.ts test/commands/nars.test.ts test/commands/workspace-launch-admission.test.ts && pnpm run test:realfs",
    "test:launcher:focused": "node --import tsx scripts/run-launcher-focused.ts",
    "test:publication-boundary": "node --import tsx scripts/run-publication-boundary-e2e.ts",
    "test:launcher-acceptance": "pnpm run build && node --import tsx --test --test-concurrency=1 test/integration/operator-launch-journey.test.ts",
    "test:operator-journey-acceptance": "pnpm run build && pnpm --filter @narada-core/agent-web-ui build && node --import tsx --test --test-concurrency=1 test/integration/operator-journey-acceptance-e2e.test.ts",
    "test:carrier-restart-live-e2e": "pnpm --filter @narada-core/agent-start build && pnpm --filter @narada-core/agent-runtime-server build && pnpm --filter @narada-core/site-common-tools build && node --import tsx --test --test-concurrency=1 scripts/run-carrier-restart-live-e2e.ts",
    "test:linux-installation-e2e": "pnpm --filter @narada-core/linux-site... build && pnpm --filter @narada-core/site-paths build && pnpm --filter @narada-core/agent-identity build && pnpm --filter @narada-core/cli build && pnpm --filter @narada-core/linux-site exec vitest run test/installation-e2e-contract.test.ts && node --import tsx scripts/run-vitest-quiet.ts run --silent test/commands/agent-web-ui-session.test.ts test/commands/nars.test.ts && pnpm run test:operator-journey-acceptance && pnpm run test:publication-boundary && node --import tsx ../../../scripts/verify-linux-installation-e2e.ts",
    "test:operator-projection-open": "node scripts/run-vitest-quiet.ts run --silent test/commands/nars.test.ts test/commands/launcher-workspace-plan.test.ts test/lib/browser-render.test.ts test/commands/task-graph.test.ts",
    "test:realfs": "pnpm --filter @narada-core/ui build && pnpm --filter @narada-core/agent-web-ui build && node --import tsx --test test/integration/*.test.ts",
    "coverage": "vitest run --coverage"
  },
