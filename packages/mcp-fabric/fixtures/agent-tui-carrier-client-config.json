{
  "schema": "narada.mcp.carrier_client_config.v0",
  "site_id": "narada-sonar",
  "carrier": "agent-tui",
  "mcpServers": {
    "sonar-scheduler": {
      "transport": "stdio",
      "command": "node",
      "args": ["scheduler.mjs"],
      "env": {
        "NARADA_SITE_ROOT": "C:/workspace/narada.sonar"
      },
      "env_vars": ["NARADA_AGENT_ID"],
      "tools": ["scheduler_runtime_status"],
      "surface_id": "sonar.scheduler",
      "target_site_root": "C:/workspace/narada.sonar"
    }
  }
}
