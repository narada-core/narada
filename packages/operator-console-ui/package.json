{
  "name": "@narada-core/operator-console-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "private_operator_surface_ui",
    "surface": "operator_console",
    "authority_owner": "@narada-core/cli",
    "presentation_only": true,
    "launch_artifact": {
      "target": "operator-console",
      "build_script": "build",
      "output_root": "dist",
      "required_outputs": [
        "index.html",
        "assets/**"
      ]
    }
  },
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @narada-core/ui build",
    "build": "vite build --config vite.config.ts",
    "postbuild": "node --import tsx ../layers/cli/scripts/write-launch-artifact.ts --target operator-console --package-root . --site-root ../..",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "pnpm run typecheck && node --import tsx --test test/projections.test.ts test/site-registry-domain.test.ts test/site-registry-adapter.test.ts test/agent-sessions-adapter.test.ts test/agent-sessions-scope.test.ts test/host-fleet-adapter.test.ts test/site-agents-adapter.test.ts test/site-agents-interactions.test.ts test/projection-handoff.test.ts test/routes.test.ts test/route-directory.test.ts test/site-registry-workflow.test.ts test/architecture-boundary.test.ts test/epistemic-graph-transport.test.ts"
  },
  "dependencies": {
    "@narada-core/host-fleet": "workspace:*",
    "@narada-core/operator-console-contract": "workspace:*",
    "@narada-core/site-registry-contract": "workspace:*",
    "@narada-core/ui-vue": "workspace:*",
    "lucide-vue-next": "^0.563.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.7.0",
    "vite": "^8.1.5",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/operator-console-ui"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
