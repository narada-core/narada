{
  "name": "@narada-core/window-overlay-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "reusable_windows_overlay_mechanics",
    "authority_owner": "@narada-core/window-overlay-core",
    "presentation_only": false
  },
  "bin": {"narada-window-overlay-core": "./dist/cli.js"},
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": "./src/window-surface-overlay.ps1",
    "./inspect": "./src/Inspect-WindowSurfaceOverlay.ps1",
    "./install": "./src/Install-WindowSurfaceOverlay.ps1",
    "./start": "./src/Start-WindowSurfaceOverlay.ps1",
    "./stop": "./src/Stop-WindowSurfaceOverlay.ps1",
    "./toast-host": "./src/window-toast-viewport.ps1",
    "./toast-start": "./src/Start-WindowToastViewport.ps1",
    "./toast-stop": "./src/Stop-WindowToastViewport.ps1",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/window-overlay-core.test.ts",
    "test:live": "node --import tsx --test src/window-overlay-live.e2e.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "description": "Reusable Windows overlay-window mechanics for Narada operator surfaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/window-overlay-core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {"node": ">=22.0.0"}
}
